<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A3F5D2E4-7C19-4B0A-9E2D-1F8C6B5A4D3E}</ProjectGuid>
    <ProjectName>vec4ipa_wap</ProjectName>
    <RootNamespace>vec4ipa_wap</RootNamespace>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <AppxPackage>true</AppxPackage>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>true</AppxAutoIncrementPackageRevision>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\AppPackages\</AppxPackageDir>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(Platform)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(Platform)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="AppxManifest.xml" />
    <Content Include="..\bin\x64\Release\net9.0-windows10.0.19041.0\win-x64\App.xbf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\bin\x64\Release\net9.0-windows10.0.19041.0\win-x64\MainWindow.xbf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\bin\x64\Release\net9.0-windows10.0.19041.0\win-x64\resources.pri">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>resources.pri</Link>
    </Content>
    <ProjectReference Include="..\vec4ipa_ui.csproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <PropertyGroup>
    <SdkBuildToolsProps>$(UserProfile)\.nuget\packages\microsoft.windows.sdk.buildtools\10.0.26100.1742\build\Microsoft.Windows.SDK.BuildTools.props</SdkBuildToolsProps>
  </PropertyGroup>
  <PropertyGroup>
    <!-- the referenced net9 project ships its own resources.pri; the legacy
         WAP's in-proc .resources scan cannot load net9 assemblies -->
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <!-- keep the net9 project's resources.pri (it indexes App.xbf/MainWindow.xbf
         and the assets; the WAP's own MakePri run produces an empty 920-byte
         index that breaks XAML LoadComponent and tile-icon lookup) -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxUseResourceIndexerApi>false</AppxUseResourceIndexerApi>
    <!-- the WinAppSDK MrtCore targets reassign the pipeline version only
         after the Appx targets computed the sideload flag, so pin it -->
    <BuildAppxSideloadPackageForUap>true</BuildAppxSideloadPackageForUap>
  </PropertyGroup>
  <Import Project="$(SdkBuildToolsProps)" Condition="Exists('$(SdkBuildToolsProps)')" />
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" />
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.AppxPackage.Targets" />
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- self-contained Windows App Runtime: dist\ runs on any machine
         with no runtime install and no DDLM registration (framework-
         dependent mode fails with REGDB_E_CLASSNOTREG in
         Application.Start when the installed runtime's dynamic
         dependency registration is unavailable).  The WAP/MSIX build
         (ui/winui/wap) overrides this to false for its packaged app,
         which uses the installed framework package instead. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefaultResourceLanguage>en-US</DefaultResourceLanguage>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
    <RootNamespace>Vec4ipaUI</RootNamespace>
    <AssemblyName>vec4ipa_ui</AssemblyName>
    <ApplicationIcon>..\vec_ipa.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0.0</Version>
    <Authors>vec4ipa contributors</Authors>
    <Description>WinUI 3 workbench for the vec4ipa tool suite (IPA &lt;-&gt; 16-D vectors).</Description>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/csiroqa/vec4ipa</RepositoryUrl>
    <Product>vec4ipa Workbench</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\final_ink.png" Link="Assets\final_ink.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.png" Link="Assets\Square44x44Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square71x71Logo.png" Link="Assets\Square71x71Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.png" Link="Assets\Square150x150Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square310x310Logo.png" Link="Assets\Square310x310Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\StoreLogo.png" Link="Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.png" Link="Assets\SplashScreen.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\vec_ipa.ico" Link="vec_ipa.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\ipa2vec.exe" Link="tools\ipa2vec.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vec2ipa.exe" Link="tools\vec2ipa.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vec4ipa.exe" Link="tools\vec4ipa.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\ipa2vec_core.dll" Link="ipa2vec_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\fonts\GentiumBookPlus-Regular.ttf" Link="fonts\GentiumBookPlus-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

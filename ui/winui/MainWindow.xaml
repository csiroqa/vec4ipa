<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IPA2VectorUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IPA2VectorUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IPA2Vector Workbench">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="560"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- left column: inputs / output (output stretches with window) -->
        <Grid Grid.Column="0" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock x:Name="LblIpa" Text="Actions:" FontSize="15" Visibility="Collapsed"/>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="FileBtn" Grid.Column="0" Content="File" Padding="10,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem x:Name="MExamples" Text="Examples">
                                <MenuFlyoutItem Text="English: tʰa (aspirated t + a)" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Mandarin: ma˥˩ (falling tone)" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Nasalised: ɛ̃ (nasalised vowel)" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Affricate: t͡ʃa (ch + a)" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Ejective: kʼa (ejective k)" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Click: ǃ̃o (nasal click)" Click="Example_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="MOpen" Text="Open file and convert..." Click="OpenFileConvert_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MExportCmd" Text="Export command lines..." Click="ExportCmd_Click"/>
                            <MenuFlyoutItem x:Name="MExportTools" Text="Export tools (ipa2vec/vec2ipa/vec4ipa)..." Click="ExportTools_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MExit" Text="Exit" Click="Exit_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ViewBtn" Grid.Column="1" Content="View" Padding="10,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MTable" Text="Base table" Click="ViewTable_Click"/>
                            <MenuFlyoutItem x:Name="MModules" Text="Module details" Click="ViewModules_Click"/>
                            <MenuFlyoutItem x:Name="MStats" Text="Statistics" Click="ViewStats_Click"/>
                            <MenuFlyoutItem x:Name="MWeights" Text="Metric weights" Click="ViewWeights_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MCompare" Text="Compare symbols..." Click="Compare_Click"/>
                            <MenuFlyoutItem x:Name="MVectorEditor" Text="Vector editor..." Click="VectorEditor_Click"/>
                            <MenuFlyoutItem x:Name="MHistory" Text="History..." Click="History_Click"/>
                            <MenuFlyoutItem x:Name="MLoop" Text="Convert + reverse loop" Click="Loop_Click"/>
                            <MenuFlyoutItem x:Name="MLoadMetric" Text="Load metric.json..." Click="LoadMetric_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MExportCsv" Text="Export table as CSV..." Click="ExportCsv_Click"/>
                            <MenuFlyoutItem x:Name="MSaveIr" Text="Save IR files (layer1/layer2)..." Click="SaveIr_Click"/>
                            <MenuFlyoutItem x:Name="MSaveOutput" Text="Save output as..." Click="SaveOutput_Click"/>
                            <MenuFlyoutItem x:Name="MClear" Text="Clear output" Click="ClearOutput_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MSettings" Text="Settings..." Click="Settings_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="HelpBtn" Grid.Column="2" Content="Help" Padding="10,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MDocs" Text="Documentation" Click="Docs_Click"/>
                            <MenuFlyoutItem x:Name="MAbout" Text="About" Click="About_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="LoopBtn" Grid.Column="3" Content="Loop" Padding="10,4"
                        Click="Loop_Click"/>
                <ComboBox x:Name="FormatCombo" Grid.Column="4" SelectedIndex="0">
                    <ComboBoxItem Content="vectors"/>
                    <ComboBoxItem Content="IR"/>
                    <ComboBoxItem Content="JSON"/>
                </ComboBox>
                <Button x:Name="ConvertBtn" Grid.Column="5" Content="Convert"
                        Padding="10,4" HorizontalAlignment="Stretch"
                        Click="ConvertBtn_Click"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="LblVec" Text="16-D vector (comma separated) → reverse fit:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VecInput" Grid.Column="0" FontSize="15"
                         AcceptsReturn="True" Height="72"
                         TextWrapping="Wrap"/>
                <ComboBox x:Name="WidthCombo" Grid.Column="1" SelectedIndex="3"
                          Width="110">
                    <ComboBoxItem Content="width 0"/>
                    <ComboBoxItem Content="width 1"/>
                    <ComboBoxItem Content="width 2"/>
                    <ComboBoxItem Content="width 3"/>
                    <ComboBoxItem Content="width 4"/>
                </ComboBox>
                <Button x:Name="ReverseBtn" Grid.Column="2" Content="Reverse"
                        Click="ReverseBtn_Click"/>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblDist" Text="Distance between two symbols:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="5" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DistA" Grid.Column="0" FontSize="18"/>
                <TextBox x:Name="DistB" Grid.Column="1" FontSize="18"/>
                <Button x:Name="DistBtn" Grid.Column="2" Content="Distance"
                        Click="DistBtn_Click"/>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblOut" Text="Output:" FontSize="15"/>
                <Button Grid.Column="1" Content="Copy" FontSize="12"
                        Padding="8,2" Margin="0,0,6,0" Click="CopyOutput_Click"/>
                <Button Grid.Column="2" Content="Clear" FontSize="12"
                        Padding="8,2" Click="ClearOutput_Click"/>
            </Grid>
            <RichEditBox x:Name="OutputBox" Grid.Row="7" FontSize="15"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MinHeight="80"/>
        </Grid>

        <!-- draggable splitter between left pane and keyboard -->
        <Rectangle x:Name="Splitter" Grid.Column="1" Width="6" Fill="Transparent"
                   PointerPressed="Splitter_Pressed"
                   PointerMoved="Splitter_Moved"
                   PointerReleased="Splitter_Released"
                   PointerCanceled="Splitter_Released"
                   PointerCaptureLost="Splitter_Released"/>

        <!-- right column: soft-keyboard input box on top, keyboard below -->
        <Grid Grid.Column="2" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="IpaInputRight" Grid.Row="0"
                     FontFamily="Gentium Book Plus" FontSize="24"
                     MinHeight="44" Margin="0,0,0,6"
                     PlaceholderText="IPA - soft keyboard input"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            <ScrollViewer Grid.Row="1" x:Name="KeyboardScroll"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="4,0,4,12" Spacing="2">
                <TextBlock x:Name="LblCons" Text="Consonants" FontWeight="SemiBold" FontSize="14"
                           Margin="0,6,0,2"/>
                <ItemsControl x:Name="ConsKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LblNp" Text="Non-pulmonic" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2"/>
                <ItemsControl x:Name="NpKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LblVow" Text="Vowels" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2"/>
                <ItemsControl x:Name="VowKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LblDiac" Text="Diacritics" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2"/>
                <ItemsControl x:Name="DiacKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LblLet" Text="Letters" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2"/>
                <ItemsControl x:Name="LetterKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LblTone" Text="Tones" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2"/>
                <ItemsControl x:Name="ToneKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LblRec" Text="Recent" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2"/>
                <ItemsControl x:Name="RecentKeys">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        </Grid>

        <!-- status bar -->
        <Grid Grid.Row="2" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IPA2VectorUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IPA2VectorUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IPA2Vector Workbench">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutSubItem Text="Examples">
                    <MenuFlyoutItem Text="English: tʰa (aspirated t + a)" Click="Example_Click"/>
                    <MenuFlyoutItem Text="Mandarin: ma˥˩ (falling tone)" Click="Example_Click"/>
                    <MenuFlyoutItem Text="Nasalised: ɛ̃ (nasalised vowel)" Click="Example_Click"/>
                    <MenuFlyoutItem Text="Affricate: t͡ʃa (ch + a)" Click="Example_Click"/>
                    <MenuFlyoutItem Text="Ejective: kʼa (ejective k)" Click="Example_Click"/>
                    <MenuFlyoutItem Text="Click: ǃ̃o (nasal click)" Click="Example_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Open file and convert..." Click="OpenFileConvert_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Export command lines..." Click="ExportCmd_Click"/>
                <MenuFlyoutItem Text="Export tools (ipa2vec/vec2ipa/vec4ipa)..." Click="ExportTools_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="Exit_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutSubItem x:Name="ModulesSub" Text="Modules (schools)"/>
                <MenuFlyoutItem Text="Base table" Click="ViewTable_Click"/>
                <MenuFlyoutItem Text="Module details" Click="ViewModules_Click"/>
                <MenuFlyoutItem Text="Statistics" Click="ViewStats_Click"/>
                <MenuFlyoutItem Text="Metric weights" Click="ViewWeights_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Load metric.json..." Click="LoadMetric_Click"/>
                <MenuFlyoutItem Text="Compare symbols..." Click="Compare_Click"/>
                <MenuFlyoutItem Text="Vector editor..." Click="VectorEditor_Click"/>
                <MenuFlyoutItem Text="History..." Click="History_Click"/>
                <MenuFlyoutSeparator/>
                <ToggleMenuFlyoutItem Text="Feature names (tt_pos=0.55)" Click="FeatureNames_Click"/>
                <MenuFlyoutSubItem Text="Theme">
                    <RadioMenuFlyoutItem Text="System" GroupName="theme" IsChecked="True" Click="Theme_Click"/>
                    <RadioMenuFlyoutItem Text="Light" GroupName="theme" Click="Theme_Click"/>
                    <RadioMenuFlyoutItem Text="Dark" GroupName="theme" Click="Theme_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Convert + reverse loop" Click="Loop_Click"/>
                <MenuFlyoutItem Text="Export table as CSV..." Click="ExportCsv_Click"/>
                <MenuFlyoutItem Text="Save IR files (layer1/layer2)..." Click="SaveIr_Click"/>
                <MenuFlyoutItem Text="Save output as..." Click="SaveOutput_Click"/>
                <MenuFlyoutItem Text="Clear output" Click="ClearOutput_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Language">
                <RadioMenuFlyoutItem Text="English" GroupName="lang" IsChecked="True" Click="Lang_Click"/>
                <RadioMenuFlyoutItem Text="中文" GroupName="lang" Click="Lang_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Documentation" Click="Docs_Click"/>
                <MenuFlyoutItem Text="About" Click="About_Click"/>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="560"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- left column: inputs / output (output stretches with window) -->
        <Grid Grid.Column="0" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock x:Name="LblIpa" Text="IPA input (click keyboard buttons or type):" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IpaInput" Grid.Column="0" FontSize="18"
                         AcceptsReturn="False"/>
                <ComboBox x:Name="FormatCombo" Grid.Column="1" SelectedIndex="0"
                          Width="112">
                    <ComboBoxItem Content="vectors"/>
                    <ComboBoxItem Content="IR"/>
                    <ComboBoxItem Content="JSON"/>
                </ComboBox>
                <Button x:Name="ConvertBtn" Grid.Column="2" Content="Convert"
                        Click="ConvertBtn_Click"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="LblVec" Text="16-D vector (comma separated) → reverse fit:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VecInput" Grid.Column="0" FontSize="15"
                         AcceptsReturn="True" Height="72"
                         TextWrapping="Wrap"/>
                <ComboBox x:Name="WidthCombo" Grid.Column="1" SelectedIndex="3"
                          Width="110">
                    <ComboBoxItem Content="width 0"/>
                    <ComboBoxItem Content="width 1"/>
                    <ComboBoxItem Content="width 2"/>
                    <ComboBoxItem Content="width 3"/>
                    <ComboBoxItem Content="width 4"/>
                </ComboBox>
                <Button x:Name="ReverseBtn" Grid.Column="2" Content="Reverse"
                        Click="ReverseBtn_Click"/>
            </Grid>

            <Grid Grid.Row="4">
                <TextBlock x:Name="LblQuery" Text="Query one symbol:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="5" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryInput" Grid.Column="0" FontSize="18"/>
                <Button x:Name="QueryBtn" Grid.Column="1" Content="Query"
                        Click="QueryBtn_Click"/>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblDist" Text="Distance between two symbols:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="7" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DistA" Grid.Column="0" FontSize="18"/>
                <TextBox x:Name="DistB" Grid.Column="1" FontSize="18"/>
                <Button x:Name="DistBtn" Grid.Column="2" Content="Distance"
                        Click="DistBtn_Click"/>
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblOut" Text="Output:" FontSize="15"/>
                <Button Grid.Column="1" Content="Copy" FontSize="12"
                        Padding="8,2" Margin="0,0,6,0" Click="CopyOutput_Click"/>
                <Button Grid.Column="2" Content="Clear" FontSize="12"
                        Padding="8,2" Click="ClearOutput_Click"/>
            </Grid>
            <TextBox x:Name="OutputBox" Grid.Row="9" FontSize="15" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinHeight="80"/>
        </Grid>

        <!-- draggable splitter between left pane and keyboard -->
        <Rectangle x:Name="Splitter" Grid.Column="1" Width="6" Fill="Transparent"
                   PointerPressed="Splitter_Pressed"
                   PointerMoved="Splitter_Moved"
                   PointerReleased="Splitter_Released"
                   PointerCanceled="Splitter_Released"
                   PointerCaptureLost="Splitter_Released"/>

        <!-- right column: IPA keyboard -->
        <Pivot Grid.Column="2" x:Name="KeyboardPivot" Margin="0,8,8,8">
            <PivotItem Header="Consonants">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ConsKeys">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Vowels">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="VowKeys">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Modifiers">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModKeys">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Tones">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ToneKeys">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Recent">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecentKeys">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        </Grid>

        <!-- status bar -->
        <Grid Grid.Row="2" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>

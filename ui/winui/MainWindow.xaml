<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vec4ipaUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vec4ipaUI">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <!-- title-bar button: Fluent hover/pressed fills that follow
                     the theme; the system buttons stay untouched -->
                <Style x:Key="WinBtn" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fx"
                                                            Storyboard.TargetProperty="Fill">
                                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fx"
                                                            Storyboard.TargetProperty="Fill">
                                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="FocusStates">
                                                <VisualState x:Name="Focused">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusFx"
                                                            Storyboard.TargetProperty="Opacity">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="PointerFocused">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusFx"
                                                            Storyboard.TargetProperty="Opacity">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Unfocused"/>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Rectangle x:Name="Fx" Fill="Transparent"
                                                   RadiusX="5" RadiusY="5"/>
                                        <Rectangle x:Name="FocusFx" Fill="Transparent"
                                                   Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                   StrokeThickness="1" Opacity="0"
                                                   RadiusX="5" RadiusY="5"
                                                   Margin="-1"/>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- keyboard sections: shared wrapping panel and header
                     typography (margins vary per section, overridden locally) -->
                <ItemsPanelTemplate x:Key="KeyboardPanel">
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
                <Style x:Key="SectionHeader" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="0,10,0,2"/>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- custom title bar (drag region, icon + title); the system
             min/max/close buttons stay native (snap layouts, Win+arrows,
             maximize over the taskbar are all system-driven) and the
             always-on-top button sits right next to them -->
        <Grid Grid.Row="0" Height="28"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="12,0,0,0" Spacing="8">
                <Image x:Name="TitleIcon" Width="16" Height="16"/>
                <TextBlock x:Name="TitleText" Text="vec4ipa Workbench"
                           FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="PinBtn" Style="{StaticResource WinBtn}"
                    Content="&#xE718;"
                    HorizontalAlignment="Right" Margin="0,0,140,0"/>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="560"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="RightCol" Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- left column: inputs / output (output stretches with window) -->
        <Grid Grid.Column="0" Padding="12,0,12,8" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="FileBtn" MinHeight="34" Grid.Column="0" Content="File" Padding="10,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem x:Name="MExamples" Text="Examples">
                                <MenuFlyoutItem Text="English: tʰa (aspirated t + a)" Tag="tʰa" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Mandarin: ma˥˩ (falling tone)" Tag="ma˥˩" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Nasalised: ɛ̃ (nasalised vowel)" Tag="ɛ̃" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Affricate: t͡ʃa (ch + a)" Tag="t͡ʃa" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Ejective: kʼa (ejective k)" Tag="kʼa" Click="Example_Click"/>
                                <MenuFlyoutItem Text="Click: ǃ̃o (nasal click)" Tag="ǃ̃o" Click="Example_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="MOpen" Text="Open file and convert..." Click="OpenFileConvert_Click"/>
                            <MenuFlyoutItem x:Name="MSaveOutput" Text="Save output as..." Click="SaveOutput_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MLoadScheme" Text="Load scheme..." Click="LoadScheme_Click"/>
                            <MenuFlyoutItem x:Name="MLoadMetric" Text="Load metric.json..." Click="LoadMetric_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MExportCsv" Text="Export table as CSV..." Click="ExportCsv_Click"/>
                            <MenuFlyoutItem x:Name="MSaveIr" Text="Save IR files (layer1/layer2)..." Click="SaveIr_Click"/>
                            <MenuFlyoutItem x:Name="MExportCmd" Text="Export command lines..." Click="ExportCmd_Click"/>
                            <MenuFlyoutItem x:Name="MExportTools" Text="Export tools (ipa2vec/vec2ipa/vec4ipa)..." Click="ExportTools_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MExit" Text="Exit" Click="Exit_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ViewBtn" MinHeight="34" Grid.Column="1" Content="View" Padding="10,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MTable" Text="Base table" Click="ViewTable_Click"/>
                            <MenuFlyoutItem x:Name="MModules" Text="Module details" Click="ViewModules_Click"/>
                            <MenuFlyoutItem x:Name="MStats" Text="Statistics" Click="ViewStats_Click"/>
                            <MenuFlyoutItem x:Name="MWeights" Text="Metric weights" Click="ViewWeights_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MVectorEditor" Text="Vector editor..." Click="VectorEditor_Click"/>
                            <MenuFlyoutItem x:Name="MHistory" Text="History..." Click="History_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MSettings" Text="Settings..." Click="Settings_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="HelpBtn" MinHeight="34" Grid.Column="2" Content="Help" Padding="10,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MDocs" Text="Documentation" Click="Docs_Click"/>
                            <MenuFlyoutItem x:Name="MAbout" Text="About" Click="About_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="ExtToggle" MinHeight="34" Grid.Column="3"
                              Content="Ext" Padding="10,4"
                              ToolTipService.ToolTip="Global input: type into the focused window of other apps"
                              Checked="ExtToggle_Changed" Unchecked="ExtToggle_Changed"/>
                <Button x:Name="LoopBtn" MinHeight="34" Grid.Column="4" Content="Loop" Padding="10,4"
                        Click="Loop_Click"/>
                <Button x:Name="FmtBtn" Grid.Column="5" Width="76" MinHeight="34"
                        Padding="10,4"
                        ToolTipService.ToolTip="vectors - hold to pick format">
                    <TextBlock x:Name="FmtBtnLabel" Text="vectors"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="ConvertBtn" MinHeight="34" Grid.Column="6" Content="Convert"
                        Padding="10,4" HorizontalAlignment="Stretch"
                        Click="ConvertBtn_Click"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="LblVec" Text="16-D vector (comma separated) → reverse fit:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VecInput" Grid.Column="0" FontSize="15"
                         AcceptsReturn="True" Height="72"
                         TextWrapping="Wrap"/>
                <!-- narrowness button restored to its original spot: stacked
                     above the Reverse button (a real Button so it matches
                     the other buttons; its pointer events are wired in code
                     with handledEventsToo since Button marks them handled) -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                    <Button x:Name="WidthBtn"
                            HorizontalAlignment="Stretch" MinHeight="34"
                            ToolTipService.ToolTip="narrowness - hold to expand">
                        <TextBlock x:Name="WidthBtnLabel" Text="narrow"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ReverseBtn" Content="Reverse"
                            HorizontalAlignment="Stretch"
                            Click="ReverseBtn_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblDist" Text="Distance between two symbols:" FontSize="15"/>
            </Grid>
            <Grid Grid.Row="5" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DistA" Grid.Column="0" FontSize="18"/>
                <TextBox x:Name="DistB" Grid.Column="1" FontSize="18"/>
                <Button x:Name="DistBtn" Grid.Column="2" Content="Distance"
                        Click="DistBtn_Click"/>
                <Button x:Name="AlignBtn" Grid.Column="3" Content="Align"
                        Click="AlignBtn_Click"/>
            </Grid>

            <Grid Grid.Row="6" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblOut" Text="Output:" FontSize="15"/>
                <Button x:Name="CopyBtn" Grid.Column="1" Content="Copy" FontSize="12"
                        Padding="8,2" Click="CopyOutput_Click"/>
                <Button x:Name="ClearBtn" Grid.Column="2" Content="Clear" FontSize="12"
                        Padding="8,2" Click="ClearOutput_Click"/>
            </Grid>
            <RichEditBox x:Name="OutputBox" Grid.Row="7" FontSize="15"
                     FontFamily="Consolas"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MinHeight="80"/>
        </Grid>

        <!-- draggable splitter with a visible divider line and a grip
             button that follows it: left double-click collapses the left
             pane (right expands), right click collapses the right pane
             (left expands) -->
        <local:CursorGrid x:Name="SplitHit" Grid.Column="1" Width="12"
              Background="Transparent"
              PointerPressed="Splitter_Pressed"
              PointerMoved="Splitter_Moved"
              PointerReleased="Splitter_Released"
              PointerCanceled="Splitter_Released"
              PointerCaptureLost="Splitter_Released"
              DoubleTapped="SplitHit_DoubleTapped"
              PointerEntered="SplitHit_PointerEntered"
              PointerExited="SplitHit_PointerExited">
            <!-- centered divider: with the left column's 12px right
                 padding and the right column's 12px left margin the air
                 on both sides is equal -->
            <Rectangle Width="2"
                       HorizontalAlignment="Center"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Button x:Name="SplitGrip" Style="{StaticResource WinBtn}"
                    Width="10" Height="64" CornerRadius="5"
                    Padding="0" BorderThickness="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Left click: collapse left pane; right click: collapse right pane"
                    Click="SplitGrip_Click"
                    RightTapped="SplitGrip_RightTapped">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <Ellipse Width="4" Height="4"
                             Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Ellipse Width="4" Height="4"
                             Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Ellipse Width="4" Height="4"
                             Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Button>
        </local:CursorGrid>

        <!-- right column: soft-keyboard input box on top, keyboard below -->
        <Grid Grid.Column="2" Margin="12,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="IpaInputRight" Grid.Row="0"
                     FontFamily="Gentium Book Plus" FontSize="24"
                     MinHeight="44" Margin="0,0,0,6"
                     PlaceholderText="IPA - soft keyboard input"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            <ScrollViewer Grid.Row="1" x:Name="KeyboardScroll"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="4,0,4,12" Spacing="2">
                <TextBox x:Name="FilterBox" PlaceholderText="filter symbols (name or symbol)…"
                         FontSize="13" Margin="0,0,0,6"
                         TextChanged="FilterBox_TextChanged"/>
                <TextBlock x:Name="LblFav" Text="Favorites" Style="{StaticResource SectionHeader}"
                           Margin="0,6,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"
                           Tapped="LblFav_Tapped"/>
                <ItemsControl x:Name="FavKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblCons" Text="Consonants" Style="{StaticResource SectionHeader}"
                           Margin="0,6,0,2"/>
                <ItemsControl x:Name="ConsKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblNp" Text="Non-pulmonic" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="NpKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblVow" Text="Vowels" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="VowKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblDiac" Text="Diacritics" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="DiacKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblLet" Text="Letters" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="LetterKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblTone" Text="Tones" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="ToneKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
                <TextBlock x:Name="LblRec" Text="Recent" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="RecentKeys" ItemsPanel="{StaticResource KeyboardPanel}"/>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        </Grid>

        <!-- virtual overlay layer: the narrowness picker pops up here,
             animated out of the button (centred over it), without touching
             the layout or content of the layer below -->
        <Grid x:Name="WidthOverlay" Grid.Row="1" Canvas.ZIndex="10"
              Background="Transparent" Visibility="Collapsed"
              PointerReleased="WidthOverlay_PointerReleased"
              PointerCanceled="WidthOverlay_PointerReleased"
              PointerCaptureLost="WidthOverlay_PointerReleased">
            <Border x:Name="WidthPopBox" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Width="280" Height="102"
                    CornerRadius="10" Padding="0"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5"
                    PointerPressed="WidthPop_PointerPressed"
                    PointerMoved="WidthPop_PointerMoved"
                    PointerReleased="WidthPop_PointerReleased"
                    PointerCanceled="WidthPop_PointerReleased"
                    PointerCaptureLost="WidthPop_PointerReleased">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WidthPopScale"/>
                        <TranslateTransform x:Name="WidthPopShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border CornerRadius="9" Margin="1"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <StackPanel Spacing="3" Margin="13,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WidthPopLabel" Text="narrowness"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="WidthPopPill" Grid.Column="1"
                                    Width="78" CornerRadius="9" Padding="10,3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock x:Name="WidthPopVal" Text="narrow"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <Slider x:Name="WidthSlider"
                                Orientation="Horizontal"
                                Minimum="0" Maximum="4" Value="3"
                                TickFrequency="1" TickPlacement="Outside"
                                IsFocusEngagementEnabled="False"
                                IsHitTestVisible="False"
                                Height="40" VerticalAlignment="Center"
                                ValueChanged="WidthSlider_ValueChanged"/>
                        <TextBlock x:Name="WidthPopHint" Text="0 broadest · 4 narrowest"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- format picker: Fluent design - in-app acrylic surface on a
                 solid base, rounded rows, accent selection pill with a
                 check mark. Custom rendering, no Slider -->
            <Border x:Name="FmtPopBox" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Width="140" Height="174"
                    CornerRadius="10" Padding="0"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0"
                    Visibility="Collapsed"
                    PointerPressed="FmtPop_PointerPressed"
                    PointerMoved="FmtPop_PointerMoved"
                    PointerReleased="FmtPop_PointerReleased"
                    PointerCanceled="FmtPop_PointerReleased"
                    PointerCaptureLost="FmtPop_PointerReleased">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FmtPopScale"/>
                        <TranslateTransform x:Name="FmtPopShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border CornerRadius="9" Margin="1"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="43"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="FmtPill" Grid.RowSpan="4"
                                Height="43" CornerRadius="8"
                                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                RenderTransformOrigin="0.5,0.5"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="FmtPillBreath"/>
                                    <TranslateTransform x:Name="FmtPillTrans"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="FmtItem0" Grid.Row="0" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="FmtCheck0" Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="FmtRow0" Text="vectors"
                                           FontSize="14" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="FmtItem1" Grid.Row="1" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="FmtCheck1" Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="FmtRow1" Text="query"
                                           FontSize="14" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="FmtItem2" Grid.Row="2" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="FmtCheck2" Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="FmtRow2" Text="layers"
                                           FontSize="14" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="FmtItem3" Grid.Row="3" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="FmtCheck3" Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="FmtRow3" Text="JSON"
                                           FontSize="14" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- status bar -->
        <Grid Grid.Row="2" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>
